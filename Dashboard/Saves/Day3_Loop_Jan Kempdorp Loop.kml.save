bee7)\n        ;\n\n        \n    \n    \n                marker_cec8f2c7e8744723fa78b047497b0a2e.setIcon(icon_16741c649db325feac356f290b1ba6bc);\n            \n    \n            var marker_170c0e1499dfed488d4a96d0480af15a = L.marker(\n                [-27.9106660187, 24.8489592969],\n                {\n}\n            ).addTo(map_23436eccc54f57230ce5399ddd749f83);\n        \n    \n            var icon_3b01cb5542101da1ce85387562a42661 = L.AwesomeMarkers.icon(\n                {\n  &quot;markerColor&quot;: &quot;red&quot;,\n  &quot;iconColor&quot;: &quot;white&quot;,\n  &quot;icon&quot;: &quot;stop&quot;,\n  &quot;prefix&quot;: &quot;glyphicon&quot;,\n  &quot;extraClasses&quot;: &quot;fa-rotate-0&quot;,\n}\n            );\n        \n    \n        var popup_b113e455d9c238fbb47234c6a5b257ec = L.popup({\n  &quot;maxWidth&quot;: &quot;100%&quot;,\n});\n\n        \n            \n                var html_979e66c2ff9d9d9b5c8edbc5c54e9700 = $(`&lt;div id=&quot;html_979e66c2ff9d9d9b5c8edbc5c54e9700&quot; style=&quot;width: 100.0%; height: 100.0%;&quot;&gt;End Point&lt;/div&gt;`)[0];\n                popup_b113e455d9c238fbb47234c6a5b257ec.setContent(html_979e66c2ff9d9d9b5c8edbc5c54e9700);\n            \n        \n\n        marker_170c0e1499dfed488d4a96d0480af15a.bindPopup(popup_b113e455d9c238fbb47234c6a5b257ec)\n        ;\n\n        \n    \n    \n                marker_170c0e1499dfed488d4a96d0480af15a.setIcon(icon_3b01cb5542101da1ce85387562a42661);\n            \n    \n            var realtime_6590d906f22778979f929ff97212c93d = L.realtime(\n            &quot;http://localhost:8000/api/live-car-gps&quot;,\n            {\n  &quot;pointToLayer&quot;: \n            (f, latlng) =&gt; {\n                // 1. Calculate your heading angle\n                let angle = (f.properties.bearing !== undefined) ? (f.properties.bearing - 45) : 0;\n                \n                // 2. Inject your base64 image inside a divIcon wrapper\n                let carIcon = L.divIcon({\n               